{
  "name": "jengaplus-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "backend": "cd backend && npm start",
    "backend:install": "cd backend && npm install",
    "expo:install": "npx expo install expo-document-picker expo-file-system",
    "build:android-apk": "eas build --platform android --local",
    "build:android-aab": "eas build --platform android --local --app-build-type app-bundle",
    "build:ios": "eas build --platform ios --local",
    "build:prod": "eas build --platform android --profile production",
    "submit": "eas submit --platform android"
  },
  "dependencies": {
    "@react-native-picker/picker": "^2.4.8",
    "axios": "^1.6.0",
    "dotenv": "^16.3.1",
    "expo": "~57.0.15",
    "expo-build-properties": "~57.0.13",
    "expo-camera": "~57.0.4",
    "expo-constants": "~57.0.13",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.5",
    "expo-splash-screen": "~57.0.7",
    "expo-status-bar": "~57.0.1",
    "pdfkit": "^0.19.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-animatable": "^1.4.0",
    "react-native-chart-kit": "^7.0.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "expo-module-scripts": "^56.0.3"
  }
}
